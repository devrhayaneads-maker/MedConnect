# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# APK publicado no Firebase Hosting para o QR Code de instalação —
# binário grande, gerado via `flutter build apk --release` (ver
# public/index.html e tool/generate_qr_svg.dart). Renomeado para
# .apk.bin para contornar a restrição de "executáveis" do Hosting.
/public/*.apk
/public/*.apk.bin

# Firebase CLI (cache local de deploys) e segredos de assinatura Android
.firebase/
build/
*.jks
key.properties
